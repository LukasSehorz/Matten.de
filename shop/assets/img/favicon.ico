<script type="text/javascript">


	$(document).ready(function() {
		$("a[rel=lightbox], a.lightbox").colorbox();
		$('a[href*=youtu]').each(
			function(){
				var $a = $(this);

				var href = $a.attr('href');

				var vid = null;
				var match = href.match(/v=([^&]*)(&|$)/);
				if(match){
					vid = match[1];
				} else {
					match = href.match(/embed\/([^\/?]+)/);
					if(match){
						vid = match[1];
					} else {
						match = href.match(/youtu.be\/([^\/?]+)/);
						if(match){
							vid = match[1];
						}
					}
				}
				if(!vid){
					return;
				}

				href = "//www.youtube-nocookie.com/embed/"+vid + "?rel=0&autoplay=1&iv_load_policy=3";
				
				$a.colorbox({
					iframe:true,
					width:640,
					height:480,
					href: href
				});
			}
		);		
	});
</script>

